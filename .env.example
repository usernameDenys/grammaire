# Optional account sync (lib/sync.ts). Without these two variables the site works without sign-in.
# Supabase dashboard → Project Settings → API (or "Connect"): Project URL and the publishable key
# (the legacy "anon" key also works). Both are public by design; data is protected by row level security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
